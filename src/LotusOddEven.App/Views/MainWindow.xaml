<Window x:Class="LotusOddEven.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:conv="clr-namespace:LotusOddEven.App.Converters"
        Title="{Binding AppTitle}"
        Height="900" Width="1440"
        MinHeight="820" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#001529"
        Foreground="#E8ECF5"
        StateChanged="MainWindow_StateChanged">

  <!-- CaptionHeight=0: 커스텀 제목띠를 클라이언트 영역에 그려 첫 기동부터 보이게 함.
       창 이동은 TitleBar DragMove로 처리. GlassFrameThickness=0으로 흰 띠 방지. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SimulateRoundCommand}" />
  </Window.InputBindings>

  <Window.Resources>
    <conv:AlgorithmKindConverter x:Key="AlgoKind" />

    <SolidColorBrush x:Key="PanelBg" Color="#002140" />
    <SolidColorBrush x:Key="PanelLine" Color="#1A3A5C" />
    <SolidColorBrush x:Key="Gold" Color="#F5C542" />
    <SolidColorBrush x:Key="TextMain" Color="#F0F4FA" />
    <SolidColorBrush x:Key="TextMute" Color="#8FA3B8" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMute}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Width" Value="70" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="DarkBox" TargetType="TextBox">
      <Setter Property="Background" Value="#071628" />
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="BorderBrush" Value="#2A4A6A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Height" Value="26" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="4,2" />
    </Style>

    <!-- 설정 / 편집 공통 입체 버튼 -->
    <Style x:Key="ReliefBtn" TargetType="Button">
      <Setter Property="MinWidth" Value="48" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Foreground" Value="#F8FAFC" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="outer" CornerRadius="4" Padding="1" Background="#0B1A2E">
              <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Direction="270" Opacity="0.55" Color="#000000" />
              </Border.Effect>
              <Border x:Name="face" CornerRadius="3" Padding="10,0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop x:Name="g0" Color="#3B82F6" Offset="0" />
                    <GradientStop x:Name="g1" Color="#1D4ED8" Offset="0.55" />
                    <GradientStop x:Name="g2" Color="#1E3A8A" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                  <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#93C5FD" Offset="0" />
                    <GradientStop Color="#1E40AF" Offset="1" />
                  </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="face" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                      <GradientStop Color="#60A5FA" Offset="0" />
                      <GradientStop Color="#2563EB" Offset="0.5" />
                      <GradientStop Color="#1D4ED8" Offset="1" />
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="outer" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.85" Color="#3B82F6" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="face" Property="Background">
                  <Setter.Value>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                      <GradientStop Color="#1E3A8A" Offset="0" />
                      <GradientStop Color="#1D4ED8" Offset="1" />
                    </LinearGradientBrush>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="outer" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.4" Color="#000000" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SetBtn" TargetType="Button" BasedOn="{StaticResource ReliefBtn}" />

    <Style x:Key="MartinGridHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#0EA5E9" />
      <Setter Property="Foreground" Value="#0B1220" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Height" Value="28" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="#0369A1" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleIconBtn" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1A2F4A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeBtn" TargetType="Button" BasedOn="{StaticResource TitleIconBtn}">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="ImageActionBtn" TargetType="Button">
      <Setter Property="Width" Value="51" />
      <Setter Property="Height" Value="21" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StatusCard" TargetType="Border">
      <Setter Property="Background" Value="#0A1F38" />
      <Setter Property="BorderBrush" Value="#1E3A5F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Resources>

  <Border BorderBrush="#0D2137" BorderThickness="1">
    <DockPanel>
      <!-- ===== Title bar ===== -->
      <Border DockPanel.Dock="Top" Background="#000E1C" Height="42"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid Margin="10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="/Assets/Icons/lotus_logo.png" Width="32" Height="32" Stretch="Uniform" Margin="0,0,8,0" />
            <TextBlock Text="{Binding AppTitle}" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="#F8FAFC" />
            <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="14,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="경과 시간 :" Foreground="#7DD3FC" VerticalAlignment="Center" FontSize="12" />
            <TextBlock Text="{Binding ElapsedText}" Margin="6,0,0,0" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#4ADE80" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource TitleIconBtn}" Command="{Binding ToggleLockCommand}" ToolTip="잠금걸기"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/Icons/ico_lock.png" Width="20" Height="20" />
                <TextBlock Text="잠금걸기" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#F5C542" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource TitleIconBtn}" Command="{Binding ChangePasswordCommand}" ToolTip="비번변경"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/Icons/ico_key.png" Width="20" Height="20" />
                <TextBlock Text="비번변경" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#F5C542" />
              </StackPanel>
            </Button>

            <!-- Window chrome (Path — no image assets) -->
            <Button Style="{StaticResource ChromeBtn}" Command="{Binding MinimizeWindowCommand}" ToolTip="최소화"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Path Data="M4,14 H20" Stroke="#E2E8F0" StrokeThickness="1.5" Width="24" Height="24"
                    Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="MaximizeRestoreButton" Style="{StaticResource ChromeBtn}"
                    Command="{Binding ToggleMaximizeWindowCommand}" ToolTip="최대화"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Grid Width="24" Height="24">
                <!-- Normal: maximize (single square) -->
                <Path x:Name="MaximizeIcon" Data="M7,7 H17 V17 H7 Z" Stroke="#E2E8F0" StrokeThickness="1.5"
                      Fill="Transparent" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Maximized: restore (two overlapping squares) -->
                <Canvas x:Name="RestoreIcon" Width="24" Height="24" Visibility="Collapsed">
                  <Path Data="M9,6 H18 V15" Stroke="#E2E8F0" StrokeThickness="1.5" Fill="Transparent" />
                  <Path Data="M6,9 H15 V18 H6 Z" Stroke="#E2E8F0" StrokeThickness="1.5" Fill="Transparent" />
                </Canvas>
              </Grid>
            </Button>
            <Button Style="{StaticResource ChromeBtn}" Command="{Binding CloseWindowCommand}" ToolTip="닫기"
                    Click="CloseButton_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Path Data="M7,7 L17,17 M17,7 L7,17" Stroke="#E2E8F0" StrokeThickness="1.5"
                    Width="24" Height="24" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Body ===== -->
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="#000810" CornerRadius="6" BorderBrush="#1A3A5C" BorderThickness="1" ClipToBounds="True">
            <wv2:WebView2 x:Name="GameWebView" />
          </Border>

          <!-- Status tiles + control buttons -->
          <Grid Grid.Row="1" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatusCard}">
              <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/Icons/ico_shoe.png" Width="36" Height="36" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="현재 슈" FontSize="11" Foreground="#94A3B8" />
                  <TextBlock Text="{Binding CurrentShoeText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource StatusCard}">
              <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/Icons/ico_steps.png" Width="36" Height="36" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="현재 단계" FontSize="11" Foreground="#94A3B8" />
                  <TextBlock Text="{Binding CurrentStepText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource StatusCard}">
              <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/Icons/ico_spade.png" Width="36" Height="36" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="다음 베팅" FontSize="11" Foreground="#94A3B8" />
                  <TextBlock Text="{Binding NextBetText}" FontSize="20" FontWeight="Bold" Foreground="#7DD3FC" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource StatusCard}" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/Icons/ico_clock.png" Width="36" Height="36" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="남은 시간" FontSize="11" Foreground="#94A3B8" />
                  <TextBlock Text="{Binding RemainingTimeText}" FontSize="20" FontWeight="Bold"
                             FontFamily="Consolas" Foreground="{StaticResource Gold}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Image-only control buttons (51x21) -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,0,0">
              <Button Style="{StaticResource ImageActionBtn}" Command="{Binding StartBotCommand}" ToolTip="자동 시작">
                <Image Source="/Assets/Icons/btn_play.png" Width="51" Height="21" Stretch="Fill" />
              </Button>
              <Button Style="{StaticResource ImageActionBtn}" Command="{Binding PauseBotCommand}" ToolTip="일시 정지">
                <Image Source="/Assets/Icons/btn_pause.png" Width="51" Height="21" Stretch="Fill" />
              </Button>
              <Button Style="{StaticResource ImageActionBtn}" Command="{Binding StopBotCommand}" ToolTip="정지">
                <Image Source="/Assets/Icons/btn_stop.png" Width="51" Height="21" Stretch="Fill" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Log (only vertical scroll area) -->
          <Border Grid.Row="2" Background="#050D18" CornerRadius="6" BorderBrush="#1A3A5C" BorderThickness="1" Padding="8,6">
            <ListBox ItemsSource="{Binding Logs}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0,1" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock FontFamily="Consolas" FontSize="12">
                    <Run Text="[" Foreground="#CBD5E1" /><Run Text="{Binding Time}" Foreground="#E2E8F0" /><Run Text="]" Foreground="#CBD5E1" />
                    <Run Text=" " />
                    <Run Text="[" Foreground="#4ADE80" /><Run Text="{Binding Level}" Foreground="#4ADE80" /><Run Text="]" Foreground="#4ADE80" />
                    <Run Text=" " />
                    <Run Text="{Binding Message}" Foreground="#D1FAE5" />
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </Grid>

        <!-- RIGHT panel (no scroll) -->
        <Border Grid.Column="2" Background="#001A2E" CornerRadius="6" BorderBrush="#1A3A5C" BorderThickness="1" Padding="10">
          <DockPanel>
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsUiLocked}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>

            <!-- Algorithm bottom -->
            <Border DockPanel.Dock="Bottom" Background="#002140" CornerRadius="6" Padding="8" BorderBrush="#1A3A5C" BorderThickness="1">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                  <Image Source="/Assets/Icons/ico_star.png" Width="22" Height="22" Margin="0,0,8,0" />
                  <TextBlock Text="베팅 알고리듬" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" Style="{StaticResource DarkCombo}"
                            ItemsSource="{Binding AlgorithmOptions}"
                            SelectedItem="{Binding SelectedAlgorithm}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource AlgoKind}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Grid.Column="2" Style="{StaticResource DarkCombo}"
                            ItemsSource="{Binding ProfileOptions}"
                            SelectedItem="{Binding SelectedProfile}"
                            DisplayMemberPath="Name" />
                  <Button Grid.Column="4" Content="편집" Style="{StaticResource ReliefBtn}" Margin="0"
                          Command="{Binding EditAlgorithmCommand}" />
                </Grid>

                <DataGrid ItemsSource="{Binding MartinSteps}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          Background="#071628"
                          Foreground="#E8ECF5"
                          RowBackground="#0A1F38"
                          AlternatingRowBackground="#0D2744"
                          BorderBrush="#1A3A5C"
                          BorderThickness="1"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1A3A5C"
                          ColumnHeaderStyle="{StaticResource MartinGridHeader}"
                          RowHeaderWidth="0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="단계" Binding="{Binding Step}" Width="44" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="HorizontalAlignment" Value="Center" />
                          <Setter Property="Foreground" Value="#E2E8F0" />
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="금액" Binding="{Binding Amount, StringFormat=N0}" Width="*" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="HorizontalAlignment" Value="Right" />
                          <Setter Property="Margin" Value="0,0,8,0" />
                          <Setter Property="Foreground" Value="#FDE68A" />
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="패기록" Binding="{Binding LossRecord}" Width="56" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="HorizontalAlignment" Value="Center" />
                          <Setter Property="Foreground" Value="#FCA5A5" />
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="횟수" Binding="{Binding PlayCount}" Width="48" IsReadOnly="True">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Setter Property="HorizontalAlignment" Value="Center" />
                          <Setter Property="Foreground" Value="#93C5FD" />
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>

            <!-- Top sections -->
            <StackPanel>
              <!-- 사이트 계정 -->
              <Border Background="#002140" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="#1A3A5C" BorderThickness="1">
                <StackPanel>
                  <StackPanel Style="{StaticResource SectionHeader}">
                    <Image Source="/Assets/Icons/ico_user.png" Width="24" Height="24" Margin="0,0,8,0" />
                    <TextBlock Text="사이트 계정" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="사이트 도메인" Style="{StaticResource FieldLabel}" Width="78" />
                    <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}"
                              ItemsSource="{Binding SiteDomains}"
                              Text="{Binding SiteDomain, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" />
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="아이디" Style="{StaticResource FieldLabel}" Width="78" />
                    <TextBox Grid.Column="1" Style="{StaticResource DarkBox}"
                             Text="{Binding SiteUserId, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="비밀번호" Style="{StaticResource FieldLabel}" Width="78" />
                    <PasswordBox x:Name="SitePasswordBox" Grid.Column="1" Height="26"
                                 Background="#071628" Foreground="#F0F4FA"
                                 BorderBrush="#2A4A6A" Padding="6,3"
                                 PasswordChanged="SitePasswordBox_PasswordChanged" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 금액 정보 -->
              <Border Background="#002140" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="#1A3A5C" BorderThickness="1">
                <StackPanel>
                  <StackPanel Style="{StaticResource SectionHeader}">
                    <Image Source="/Assets/Icons/ico_coin.png" Width="24" Height="24" Margin="0,0,8,0" />
                    <TextBlock Text="금액 정보" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>

                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="보유금액" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource DarkBox}"
                             Text="{Binding Balance, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="설정" Style="{StaticResource SetBtn}" Command="{Binding ApplyBalanceCommand}" />
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="손익금액" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource DarkBox}" IsReadOnly="True"
                             Text="{Binding Profit, StringFormat=N0, Mode=OneWay}" Foreground="#60A5FA" />
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="수익종료" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource DarkBox}"
                             Text="{Binding TargetProfit, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="설정" Style="{StaticResource SetBtn}" Command="{Binding ApplyMoneyLimitsCommand}" />
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="손실종료" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource DarkBox}"
                             Text="{Binding StopLoss, UpdateSourceTrigger=PropertyChanged}" Foreground="#FACC15" />
                    <Button Grid.Column="2" Content="설정" Style="{StaticResource SetBtn}" Command="{Binding ApplyMoneyLimitsCommand}" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="누적베팅" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource DarkBox}" IsReadOnly="True"
                             Text="{Binding TotalWagered, StringFormat=N0, Mode=OneWay}" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- 베팅 설정 (단계 마무리 포함) -->
              <Border Background="#002140" CornerRadius="6" Padding="8" Margin="0,0,0,8" BorderBrush="#1A3A5C" BorderThickness="1">
                <StackPanel>
                  <StackPanel Style="{StaticResource SectionHeader}">
                    <Image Source="/Assets/Icons/ico_gear.png" Width="24" Height="24" Margin="0,0,8,0" />
                    <TextBlock Text="베팅 설정" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>

                  <WrapPanel Margin="0,0,0,6">
                    <CheckBox Content="언더/오버" IsChecked="{Binding IsUnderOverEnabled}"
                              Foreground="{StaticResource TextMain}" Margin="0,0,14,4" />
                    <CheckBox Content="레드/블랙" IsChecked="{Binding IsRedBlackEnabled}"
                              Foreground="{StaticResource TextMain}" Margin="0,0,14,4" />
                  </WrapPanel>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox IsChecked="True" IsEnabled="False" VerticalAlignment="Center" />
                    <TextBox Width="36" Margin="8,0,6,0" Style="{StaticResource DarkBox}" Height="24"
                             Text="{Binding TargetStreakCount, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="설정베팅" VerticalAlignment="Center" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal">
                    <CheckBox IsChecked="True" IsEnabled="False" VerticalAlignment="Center" />
                    <TextBox Width="36" Margin="8,0,6,0" Style="{StaticResource DarkBox}" Height="24"
                             Text="{Binding StepFinishRound, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="판 단계 마무리" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>
