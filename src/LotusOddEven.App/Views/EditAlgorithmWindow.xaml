<Window x:Class="LotusOddEven.App.Views.EditAlgorithmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="베팅 알고리듬 편집"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E2330"
        ResizeMode="CanResizeWithGrip">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="저장" Width="90" Height="32" Margin="0,0,8,0"
              Command="{Binding SaveCommand}" Background="#2563EB" Foreground="White" BorderThickness="0" />
      <Button Content="취소" Width="90" Height="32"
              Command="{Binding CancelCommand}" Background="#475569" Foreground="White" BorderThickness="0" />
    </StackPanel>

    <StackPanel>
      <TextBlock Text="세부 카테고리 이름" Foreground="#E8ECF5" Margin="0,0,0,4" />
      <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Height="30"
               VerticalContentAlignment="Center" Margin="0,0,0,6" />
      <TextBlock Text="'표준'으로 저장하면 해당 알고리듬의 기본값이 갱신됩니다. 새 이름을 입력하면 커스텀 카테고리로 보관됩니다."
                 TextWrapping="Wrap" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,10" />

      <DockPanel Margin="0,0,0,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="단계 +" Padding="10,4" Margin="0,0,6,0" Command="{Binding AddStepCommand}"
                  Background="#334155" Foreground="White" BorderThickness="0" />
          <Button Content="단계 -" Padding="10,4" Command="{Binding RemoveStepCommand}"
                  Background="#334155" Foreground="White" BorderThickness="0" />
        </StackPanel>
        <TextBlock Text="단계별 금액" Foreground="#E8ECF5" VerticalAlignment="Center" />
      </DockPanel>

      <DataGrid ItemsSource="{Binding Steps}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                Background="#111827"
                Foreground="#E8ECF5"
                RowBackground="#1F2937"
                AlternatingRowBackground="#273449"
                BorderThickness="0"
                Height="280">
        <DataGrid.Columns>
          <DataGridTextColumn Header="단계" Binding="{Binding Step}" Width="60" IsReadOnly="True" />
          <DataGridTextColumn Header="금액" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </DockPanel>
</Window>
